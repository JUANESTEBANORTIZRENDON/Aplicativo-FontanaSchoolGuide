generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["induccion"]
}

// rol ('asesor' | 'administrador') y estado ('activo' | 'inactivo' | 'bloqueado') son varchar
// protegidos por los CHECK chk_usuarios_rol y chk_usuarios_estado (ver 0_baseline_usuarios).
// Sus valores están centralizados en server/domain/enums.ts.
// La experiencia previa sigue en tieneExperienciaCobranzasDigitales; AdvisorProfile.experienceLevel
// la detalla cuando se conozca, sin duplicarla.
model Usuario {
  id                                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombreCompleto                     String    @map("nombre_completo") @db.VarChar(150)
  nombre                             String?   @db.VarChar(75)
  apellidos                          String?   @db.VarChar(75)
  fechaNacimiento                    DateTime? @map("fecha_nacimiento") @db.Date
  sexo                               String?   @db.VarChar(10)
  tipoSangre                         String?   @map("tipo_sangre") @db.VarChar(3)
  tallaCamisa                        String?   @map("talla_camisa") @db.VarChar(5)
  direccionResidencia                String?   @map("direccion_residencia") @db.VarChar(250)
  nombreContactoEmergencia           String?   @map("nombre_contacto_emergencia") @db.VarChar(150)
  numeroContactoEmergencia           String?   @map("numero_contacto_emergencia") @db.VarChar(30)
  banco                              String?   @db.VarChar(50)
  otroBanco                          String?   @map("otro_banco") @db.VarChar(100)
  numeroCuenta                       String?   @map("numero_cuenta") @db.VarChar(30)
  tipoDocumento                      String    @default("CC") @map("tipo_documento") @db.VarChar(10)
  numeroDocumento                    String    @unique @map("numero_documento") @db.VarChar(30)
  correo                             String?   @db.VarChar(150)
  telefono                           String?   @db.VarChar(30)
  passwordHash                       String    @map("password_hash")
  rol                                String    @db.VarChar(20)
  estado                             String    @default("activo") @db.VarChar(20)
  tieneExperienciaCobranzasDigitales Boolean?  @map("tiene_experiencia_cobranzas_digitales")
  fechaRespuestaExperiencia          DateTime? @map("fecha_respuesta_experiencia") @db.Timestamptz(6)
  // Cuándo terminó la inducción inicial («Conoce la empresa»). La pregunta de experiencia ya no forma parte de ella:
  // se responde dentro del módulo «Inducción a las cobranzas».
  fechaInduccionCompletada           DateTime? @map("fecha_induccion_completada") @db.Timestamptz(6)
  fechaHistoriaCompletada            DateTime? @map("fecha_historia_completada") @db.Timestamptz(6)
  fechaMetodoCompletado              DateTime? @map("fecha_metodo_completado") @db.Timestamptz(6)
  debeCompletarDatos                 Boolean   @default(true) @map("debe_completar_datos")
  fechaDatosCompletados              DateTime? @map("fecha_datos_completados") @db.Timestamptz(6)
  debeCambiarPassword                Boolean   @default(false) @map("debe_cambiar_password")
  creadoPor                          String?   @map("creado_por") @db.Uuid
  fechaCreacion                      DateTime  @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion                 DateTime  @default(now()) @map("fecha_actualizacion") @db.Timestamptz(6)
  ultimoAcceso                       DateTime? @map("ultimo_acceso") @db.Timestamptz(6)
  versionSesion                      Int       @default(0) @map("version_sesion")
  creador                            Usuario?  @relation("UsuarioCreador", fields: [creadoPor], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_usuarios_creado_por")
  creados                            Usuario[] @relation("UsuarioCreador")

  perfilAsesor             AdvisorProfile?
  progresoModulos          UserModuleProgress[]
  progresoActividad        UserActivityProgress[]
  intentos                 Attempt[]
  resultadosTyping         TypingResult[]
  resultadosSimulador      SimulatorResult[]
  sellos                   Seal[]
  certificados             Certificate[]
  excepciones              UserActivityOverride[]      @relation("ExcepcionUsuario")
  excepcionesCreadas       UserActivityOverride[]      @relation("ExcepcionCreador")
  limitesIntento           UserAttemptLimit[]          @relation("LimiteIntentoUsuario")
  limitesIntentoCreados    UserAttemptLimit[]          @relation("LimiteIntentoCreador")
  auditoria                AdminAuditLog[]
  seccionesVistas          ActivitySectionView[]
  configsOfimatica         OfficeModuleConfig[]
  bloquesCobranzas         CollectionsBlockProgress[]
  textosMecanografia       TypingText[]
  actividadesExcel         ExcelActivity[]
  ejerciciosDictado        DictationExercise[]
  solicitudesReactivacion  ReactivationRequest[]       @relation("ReactivacionUsuario")
  reactivacionesDecididas  ReactivationRequest[]       @relation("ReactivacionDecisor")
  decisionesCertificacion  CertificationDecision[]     @relation("CertificacionUsuario")
  certificacionesDecididas CertificationDecision[]     @relation("CertificacionDecisor")
  resumenesFormacion       TrainingCompletionSummary[] @relation("ResumenUsuario")
  resumenesAprobados       TrainingCompletionSummary[] @relation("ResumenAprobador")

  @@index([estado], map: "idx_usuarios_estado")
  @@index([rol], map: "idx_usuarios_rol")
  @@index([rol, estado], map: "idx_usuarios_rol_estado")
  @@index([fechaCreacion(sort: Desc), id(sort: Desc)], map: "idx_usuarios_fecha_creacion_id")
  @@map("usuarios")
  @@schema("induccion")
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("induccion")
}

enum ProgressStatus {
  NOT_STARTED
  AVAILABLE
  IN_PROGRESS
  PASSED
  FAILED
  BLOCKED

  @@schema("induccion")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
  CANCELLED

  @@schema("induccion")
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  REISSUED

  @@schema("induccion")
}

enum SealStatus {
  ACTIVE
  REVOKED

  @@schema("induccion")
}

enum OverrideAction {
  REACTIVATE
  UNLOCK
  EXTRA_ATTEMPT
  RESET_WAIT
  REOPEN_MODULE

  @@schema("induccion")
}

enum ActivityType {
  PLACEHOLDER
  LESSON
  QUIZ
  TYPING
  SIMULATOR
  TYPIFICATION
  EXCEL_PRACTICE
  DICTATION

  @@schema("induccion")
}

enum TypingCloseReason {
  COMPLETED
  EXPIRED
  ABANDONED

  @@schema("induccion")
}

enum SpellingCategory {
  HOMOFONA
  TILDE_DIACRITICA
  FORMA_VERBAL
  PUNTUACION
  MAYUSCULA

  @@schema("induccion")
}

enum SpellingSeverity {
  CRITICAL
  MINOR

  @@schema("induccion")
}

enum RecommendationSource {
  OLLAMA
  TEMPLATE

  @@schema("induccion")
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED

  @@schema("induccion")
}

enum ReactivationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("induccion")
}

enum CertificationDecisionType {
  APPROVED
  RETURNED

  @@schema("induccion")
}

enum ExperienceLevel {
  NONE
  BASIC
  INTERMEDIATE
  ADVANCED

  @@schema("induccion")
}

model AdvisorProfile {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String           @unique @map("user_id") @db.Uuid
  experienceLevel ExperienceLevel? @map("experience_level")
  area            String?          @db.VarChar(100)
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            Usuario          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("perfiles_asesor")
  @@schema("induccion")
}

model TrainingModule {
  id               String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String                     @unique @db.VarChar(80)
  name             String                     @db.VarChar(150)
  description      String?
  order            Int                        @unique @map("order")
  status           CatalogStatus              @default(DRAFT)
  isRequired       Boolean                    @default(true) @map("is_required")
  route            String                     @db.VarChar(200)
  createdAt        DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  activities       Activity[]
  prerequisites    ModulePrerequisite[]       @relation("ModuloDependiente")
  dependents       ModulePrerequisite[]       @relation("ModuloRequisito")
  progress         UserModuleProgress[]
  seals            Seal[]
  bloquesCobranzas CollectionsBlockProgress[]

  @@map("modulos_formacion")
  @@schema("induccion")
}

model CollectionsBlockProgress {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  moduleId       String         @map("module_id") @db.Uuid
  blockKey       String         @map("block_key") @db.VarChar(30)
  contentVersion Int            @map("content_version")
  attempts       Int            @default(0)
  answers        Json
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           Usuario        @relation(fields: [userId], references: [id], onDelete: Restrict)
  module         TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([userId, moduleId, blockKey, contentVersion], map: "uq_cobranzas_bloque_usuario_version")
  @@map("progreso_bloques_cobranzas")
  @@schema("induccion")
}

model ModulePrerequisite {
  moduleId             String         @map("module_id") @db.Uuid
  prerequisiteModuleId String         @map("prerequisite_module_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  module               TrainingModule @relation("ModuloDependiente", fields: [moduleId], references: [id], onDelete: Restrict)
  prerequisite         TrainingModule @relation("ModuloRequisito", fields: [prerequisiteModuleId], references: [id], onDelete: Restrict)

  @@id([moduleId, prerequisiteModuleId])
  @@index([prerequisiteModuleId])
  @@map("prerrequisitos_modulo")
  @@schema("induccion")
}

model Activity {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId             String                 @map("module_id") @db.Uuid
  type                 ActivityType
  order                Int                    @map("order")
  status               CatalogStatus          @default(DRAFT)
  title                String                 @db.VarChar(150)
  isRequired           Boolean                @default(true) @map("is_required")
  route                String?                @db.VarChar(200)
  version              Int                    @default(1)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  module               TrainingModule         @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  evaluations          Evaluation[]
  progress             UserActivityProgress[]
  overrides            UserActivityOverride[]
  attemptLimits        UserAttemptLimit[]
  sectionViews         ActivitySectionView[]
  reactivationRequests ReactivationRequest[]

  @@unique([moduleId, order])
  @@index([moduleId, status])
  @@map("actividades")
  @@schema("induccion")
}

model UserModuleProgress {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  moduleId       String         @map("module_id") @db.Uuid
  status         ProgressStatus @default(NOT_STARTED)
  percent        Decimal        @default(0) @db.Decimal(5, 2)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  lastActivityAt DateTime?      @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           Usuario        @relation(fields: [userId], references: [id], onDelete: Restrict)
  module         TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([userId, moduleId])
  @@index([moduleId, status])
  @@index([lastActivityAt])
  @@map("progreso_modulo")
  @@schema("induccion")
}

model UserActivityProgress {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  activityId     String         @map("activity_id") @db.Uuid
  status         ProgressStatus @default(NOT_STARTED)
  attemptsUsed   Int            @default(0) @map("attempts_used")
  lastPracticeAt DateTime?      @map("last_practice_at") @db.Timestamptz(6)
  startedAt      DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?      @map("completed_at") @db.Timestamptz(6)
  lastActivityAt DateTime?      @map("last_activity_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user           Usuario        @relation(fields: [userId], references: [id], onDelete: Restrict)
  activity       Activity       @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([userId, activityId])
  @@index([activityId, status])
  @@map("progreso_actividad")
  @@schema("induccion")
}

// Una configuración evaluable nueva crea otra versión; una versión con intentos nunca se edita.
model Evaluation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityId     String        @map("activity_id") @db.Uuid
  version        Int
  title          String?       @db.VarChar(150)
  minimumScore   Decimal       @map("minimum_score") @db.Decimal(5, 2)
  maxAttempts    Int           @map("max_attempts")
  waitMinutes    Int           @default(0) @map("wait_minutes")
  // Examen general: cuántas preguntas se sortean del banco y qué versión del banco se usa.
  questionCount  Int?          @map("question_count")
  contentVersion Int?          @map("content_version")
  status         CatalogStatus @default(DRAFT)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  activity       Activity      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  attempts       Attempt[]

  @@unique([activityId, version])
  @@index([activityId, status])
  @@map("evaluaciones")
  @@schema("induccion")
}

model Attempt {
  id                   String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String                  @map("user_id") @db.Uuid
  evaluationId         String                  @map("evaluation_id") @db.Uuid
  number               Int
  score                Decimal?                @db.Decimal(5, 2)
  status               AttemptStatus           @default(IN_PROGRESS)
  startedAt            DateTime                @default(now()) @map("started_at") @db.Timestamptz(6)
  submittedAt          DateTime?               @map("submitted_at") @db.Timestamptz(6)
  durationSeconds      Int?                    @map("duration_seconds")
  overrideId           String?                 @map("override_id") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  user                 Usuario                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  evaluation           Evaluation              @relation(fields: [evaluationId], references: [id], onDelete: Restrict)
  override             UserActivityOverride?   @relation(fields: [overrideId], references: [id], onDelete: Restrict)
  answers              AttemptAnswer[]
  typingResults        TypingResult[]
  simulatorResults     SimulatorResult[]
  typificationResults  TypificationResult[]
  seals                Seal[]
  typingInternal       TypingAttemptResult?
  excelResult          ExcelAttemptResult?
  dictationResult      DictationAttemptResult?
  reactivationRequests ReactivationRequest[]

  @@unique([userId, evaluationId, number])
  @@index([userId, evaluationId, createdAt])
  @@index([evaluationId, status])
  @@map("intentos")
  @@schema("induccion")
}

// questionId/optionId son texto sin FK: el banco de preguntas todavía no existe.
model AttemptAnswer {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId    String   @map("attempt_id") @db.Uuid
  questionId   String   @map("question_id") @db.VarChar(100)
  optionId     String?  @map("option_id") @db.VarChar(100)
  isCorrect    Boolean? @map("is_correct")
  awardedScore Decimal? @map("awarded_score") @db.Decimal(5, 2)
  // Orden de la pregunta dentro del intento (examen general: preguntas sorteadas del banco).
  position     Int?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  attempt      Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@map("respuestas_intento")
  @@schema("induccion")
}

model TypingResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  attemptId       String?  @map("attempt_id") @db.Uuid
  providerEventId String   @unique @map("provider_event_id") @db.VarChar(150)
  wpm             Int
  accuracy        Decimal  @db.Decimal(5, 2)
  errors          Int
  rawPayload      Json     @map("raw_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt         Attempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("resultados_mecanografia")
  @@schema("induccion")
}

model SimulatorResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  attemptId       String   @map("attempt_id") @db.Uuid
  scenarioVersion String   @map("scenario_version") @db.VarChar(50)
  errors          Int
  durationSeconds Int      @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@map("resultados_simulador")
  @@schema("induccion")
}

// Ejercicio oficial de Tipifica: category = perfil, subcategory = motivo no pago, observation = gestión escrita.
// fields guarda los campos del formulario y checks el resultado compacto de cada regla ({ id, ok }).
model TypificationResult {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId       String   @map("attempt_id") @db.Uuid
  catalogVersion  String   @map("catalog_version") @db.VarChar(50)
  category        String   @db.VarChar(100)
  subcategory     String?  @db.VarChar(100)
  observation     String?
  exerciseKey     String?  @map("exercise_key") @db.VarChar(40)
  scenarioVersion Int?     @map("scenario_version")
  rulesVersion    Int?     @map("rules_version")
  fields          Json?
  metCount        Int?     @map("met_count")
  unmetCount      Int?     @map("unmet_count")
  checks          Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([attemptId])
  @@map("resultados_tipificacion")
  @@schema("induccion")
}

// Un solo sello ACTIVE por usuario y módulo: índice único parcial uq_sellos_activo (SQL manual).
model Seal {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  moduleId          String         @map("module_id") @db.Uuid
  issuedAt          DateTime       @default(now()) @map("issued_at") @db.Timestamptz(6)
  status            SealStatus     @default(ACTIVE)
  evidenceAttemptId String?        @map("evidence_attempt_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              Usuario        @relation(fields: [userId], references: [id], onDelete: Restrict)
  module            TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  evidenceAttempt   Attempt?       @relation(fields: [evidenceAttemptId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([moduleId, status])
  @@map("sellos")
  @@schema("induccion")
}

// Un solo certificado ACTIVE por usuario: índice único parcial uq_certificados_activo (SQL manual).
model Certificate {
  id                    String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String                     @map("user_id") @db.Uuid
  code                  String                     @unique @db.VarChar(40)
  status                CertificateStatus          @default(ACTIVE)
  issuedAt              DateTime                   @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt             DateTime?                  @map("revoked_at") @db.Timestamptz(6)
  revokeReason          String?                    @map("revoke_reason")
  fileUrl               String?                    @map("file_url")
  // Primera vez que el asesor vio la felicitación de su certificación (no se repite en cada ingreso).
  celebratedAt          DateTime?                  @map("celebrated_at") @db.Timestamptz(6)
  previousCertificateId String?                    @unique @map("previous_certificate_id") @db.Uuid
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  Usuario                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  previousCertificate   Certificate?               @relation("Reemision", fields: [previousCertificateId], references: [id], onDelete: Restrict)
  nextCertificate       Certificate?               @relation("Reemision")
  decision              CertificationDecision?
  summary               TrainingCompletionSummary?

  @@index([userId, status])
  @@map("certificados")
  @@schema("induccion")
}

// Vigente = revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now()).
model UserActivityOverride {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  activityId          String               @map("activity_id") @db.Uuid
  action              OverrideAction
  extraAttempts       Int                  @default(0) @map("extra_attempts")
  reason              String
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz(6)
  revokeReason        String?              @map("revoke_reason")
  consumedAt          DateTime?            @map("consumed_at") @db.Timestamptz(6)
  createdById         String               @map("created_by_id") @db.Uuid
  idempotencyKey      String               @unique @map("idempotency_key") @db.VarChar(100)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  user                Usuario              @relation("ExcepcionUsuario", fields: [userId], references: [id], onDelete: Restrict)
  activity            Activity             @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdBy           Usuario              @relation("ExcepcionCreador", fields: [createdById], references: [id], onDelete: Restrict)
  attempts            Attempt[]
  reactivationRequest ReactivationRequest?

  @@index([userId, activityId, revokedAt, expiresAt])
  @@index([createdById, createdAt])
  @@map("excepciones_actividad")
  @@schema("induccion")
}

// Cupo de intentos de un asesor en una actividad. Sustituye el máximo de la evaluación solo para ese asesor;
// sin fila, rige la configuración de la evaluación. Cada cambio queda en la auditoría.
model UserAttemptLimit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  maxAttempts Int      @map("max_attempts")
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user        Usuario  @relation("LimiteIntentoUsuario", fields: [userId], references: [id], onDelete: Restrict)
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)
  createdBy   Usuario  @relation("LimiteIntentoCreador", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, activityId])
  @@map("limites_intento_usuario")
  @@schema("induccion")
}

// Solo inserción: ningún servicio la actualiza ni la borra.
// beforeJson/afterJson nunca incluyen passwordHash ni versionSesion.
model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(60)
  entityId    String   @map("entity_id") @db.VarChar(100)
  beforeJson  Json?    @map("before_json")
  afterJson   Json?    @map("after_json")
  reason      String?
  requestId   String?  @map("request_id") @db.VarChar(100)
  ip          String?  @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       Usuario  @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("auditoria_admin")
  @@schema("induccion")
}

// Solicitud del asesor para volver a presentar una evaluación oficial no aprobada. Una sola PENDING por asesor y
// actividad (índice único parcial uq_reactivacion_pendiente, SQL manual). Las nuevas solicitudes archivan y
// reinician el recorrido; las históricas crean una excepción REACTIVATE para una actividad.
model ReactivationRequest {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String                @map("user_id") @db.Uuid
  activityId     String                @map("activity_id") @db.Uuid
  attemptId      String?               @map("attempt_id") @db.Uuid
  status         ReactivationStatus    @default(PENDING)
  advisorNote    String?               @map("advisor_note") @db.VarChar(500)
  // Las solicitudes nuevas reinician el recorrido completo; las históricas conservan su alcance.
  restartCourse  Boolean               @default(false) @map("restart_course")
  report         Json?
  courseArchive  Json?                 @map("course_archive")
  decisionReason String?               @map("decision_reason")
  decidedById    String?               @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?             @map("decided_at") @db.Timestamptz(6)
  overrideId     String?               @unique @map("override_id") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  user           Usuario               @relation("ReactivacionUsuario", fields: [userId], references: [id], onDelete: Restrict)
  activity       Activity              @relation(fields: [activityId], references: [id], onDelete: Restrict)
  attempt        Attempt?              @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  decidedBy      Usuario?              @relation("ReactivacionDecisor", fields: [decidedById], references: [id], onDelete: Restrict)
  override       UserActivityOverride? @relation(fields: [overrideId], references: [id], onDelete: Restrict)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, activityId, createdAt])
  @@map("solicitudes_reactivacion")
  @@schema("induccion")
}

// Decisión del administrador sobre la certificación de un asesor. Solo inserción.
// RETURNED señala en activityIds las actividades que requieren intervención (sin borrar resultados).
model CertificationDecision {
  id            String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                    @map("user_id") @db.Uuid
  decision      CertificationDecisionType
  reason        String?
  activityIds   String[]                  @default([]) @map("activity_ids")
  certificateId String?                   @unique @map("certificate_id") @db.Uuid
  decidedById   String                    @map("decided_by_id") @db.Uuid
  createdAt     DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user          Usuario                   @relation("CertificacionUsuario", fields: [userId], references: [id], onDelete: Restrict)
  decidedBy     Usuario                   @relation("CertificacionDecisor", fields: [decidedById], references: [id], onDelete: Restrict)
  certificate   Certificate?              @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([decision, createdAt])
  @@map("decisiones_certificacion")
  @@schema("induccion")
}

// Resumen compacto de un ciclo formativo certificado: una fila por asesor y ciclo. Solo indicadores y referencias;
// los intentos, respuestas, auditoría y certificados originales se conservan.
model TrainingCompletionSummary {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  cycle              Int         @default(1)
  trainingProfile    String      @map("training_profile") @db.VarChar(20)
  planVersion        Int         @map("plan_version")
  status             String      @default("CERTIFICADO") @db.VarChar(20)
  startedAt          DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime?   @map("completed_at") @db.Timestamptz(6)
  certifiedAt        DateTime    @map("certified_at") @db.Timestamptz(6)
  approvedById       String?     @map("approved_by_id") @db.Uuid
  certificateId      String      @unique @map("certificate_id") @db.Uuid
  certificateCode    String      @map("certificate_code") @db.VarChar(40)
  // [{ slug, name, completedAt }] y [{ key, title, score, passed, attempts }]
  modules            Json
  activityScores     Json        @map("activity_scores")
  typificationPassed Int         @map("typification_passed")
  typificationTotal  Int         @map("typification_total")
  finalExamScore     Decimal?    @map("final_exam_score") @db.Decimal(5, 2)
  diagnosticScore    Decimal?    @map("diagnostic_score") @db.Decimal(5, 2)
  totalAttempts      Int         @map("total_attempts")
  reactivations      Int
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user               Usuario     @relation("ResumenUsuario", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy         Usuario?    @relation("ResumenAprobador", fields: [approvedById], references: [id], onDelete: Restrict)
  certificate        Certificate @relation(fields: [certificateId], references: [id], onDelete: Restrict)

  @@unique([userId, cycle])
  @@index([certifiedAt(sort: Desc)])
  @@map("resumen_formacion")
  @@schema("induccion")
}

model WebhookEvent {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String        @db.VarChar(50)
  providerEventId String        @map("provider_event_id") @db.VarChar(150)
  receivedAt      DateTime      @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?     @map("processed_at") @db.Timestamptz(6)
  status          WebhookStatus @default(RECEIVED)
  payload         Json
  error           String?

  @@unique([provider, providerEventId])
  @@map("eventos_webhook")
  @@schema("induccion")
}

// ---------------------------------------------------------------------------------------------
// Módulo "Ofimática para tus cobranzas": configuración, mecanografía interna, Excel y dictado.
// ---------------------------------------------------------------------------------------------

// Una sola versión ACTIVE por moduleKey (índice único parcial en la migración). Nunca se edita:
// cada cambio crea una versión nueva y archiva la anterior.
model OfficeModuleConfig {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleKey                String        @map("module_key") @db.VarChar(80)
  version                  Int
  status                   CatalogStatus @default(DRAFT)
  typingDurationSeconds    Int           @default(60) @map("typing_duration_seconds")
  typingMinCorrectCpm      Int           @default(150) @map("typing_min_correct_cpm")
  typingMinAccuracy        Decimal       @default(90) @map("typing_min_accuracy") @db.Decimal(5, 2)
  typingMaxAttempts        Int           @default(3) @map("typing_max_attempts")
  typingStartWindowSeconds Int           @default(15) @map("typing_start_window_seconds")
  typingAttemptTtlMinutes  Int           @default(10) @map("typing_attempt_ttl_minutes")
  excelMinScore            Decimal       @default(80) @map("excel_min_score") @db.Decimal(5, 2)
  excelMaxAttempts         Int           @default(3) @map("excel_max_attempts")
  dictationMinScore        Decimal       @default(85) @map("dictation_min_score") @db.Decimal(5, 2)
  dictationMaxAttempts     Int           @default(3) @map("dictation_max_attempts")
  dictationMaxPlays        Int           @default(2) @map("dictation_max_plays")
  reason                   String?
  createdById              String?       @map("created_by_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy                Usuario?      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([moduleKey, version])
  @@map("config_modulo_ofimatica")
  @@schema("induccion")
}

// Lecciones y microlecciones vistas: permiten reanudar el módulo después de cerrar sesión.
model ActivitySectionView {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  sectionKey String   @map("section_key") @db.VarChar(60)
  viewedAt   DateTime @default(now()) @map("viewed_at") @db.Timestamptz(6)
  user       Usuario  @relation(fields: [userId], references: [id], onDelete: Restrict)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Restrict)

  @@unique([userId, activityId, sectionKey])
  @@index([activityId])
  @@map("activity_section_views")
  @@schema("induccion")
}

// Banco de textos ficticios (650 a 900 caracteres). Editar un texto ya usado crea otra versión.
model TypingText {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String                @db.VarChar(60)
  version     Int                   @default(1)
  title       String                @db.VarChar(150)
  content     String
  locale      String                @default("es-CO") @db.VarChar(10)
  status      CatalogStatus         @default(DRAFT)
  createdById String?               @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy   Usuario?              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results     TypingAttemptResult[]

  @@unique([key, version])
  @@index([status])
  @@map("textos_mecanografia")
  @@schema("induccion")
}

// Resultado de la prueba interna. nonceHash es SHA-256 del nonce; el nonce nunca se guarda.
model TypingAttemptResult {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId         String             @unique @map("attempt_id") @db.Uuid
  textId            String             @map("text_id") @db.Uuid
  textVersion       Int                @map("text_version")
  nonceHash         String             @map("nonce_hash") @db.VarChar(64)
  expiresAt         DateTime           @map("expires_at") @db.Timestamptz(6)
  startedOfficialAt DateTime?          @map("started_official_at") @db.Timestamptz(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(6)
  durationSeconds   Decimal?           @map("duration_seconds") @db.Decimal(6, 2)
  typedText         String?            @map("typed_text")
  totalCharacters   Int                @default(0) @map("total_characters")
  correctCharacters Int                @default(0) @map("correct_characters")
  insertions        Int                @default(0)
  omissions         Int                @default(0)
  substitutions     Int                @default(0)
  errorCount        Int                @default(0) @map("error_count")
  accuracy          Decimal            @default(0) @db.Decimal(5, 2)
  ppm               Decimal            @default(0) @db.Decimal(6, 2)
  correctCpm        Int                @default(0) @map("correct_cpm")
  passed            Boolean?
  closeReason       TypingCloseReason? @map("close_reason")
  suspicious        Boolean            @default(false)
  configSnapshot    Json               @map("config_snapshot")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  attempt           Attempt            @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  text              TypingText         @relation(fields: [textId], references: [id], onDelete: Restrict)

  @@index([textId])
  @@index([completedAt])
  @@map("resultados_mecanografia_interna")
  @@schema("induccion")
}

// Escenario ficticio de Excel. answerKey nunca se envía al navegador.
model ExcelActivity {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key          String               @db.VarChar(60)
  version      Int                  @default(1)
  title        String               @db.VarChar(150)
  scenarioData Json                 @map("scenario_data")
  answerKey    Json                 @map("answer_key")
  status       CatalogStatus        @default(DRAFT)
  createdById  String?              @map("created_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy    Usuario?             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results      ExcelAttemptResult[]

  @@unique([key, version])
  @@index([status])
  @@map("actividades_excel")
  @@schema("induccion")
}

// Un intento de Excel: guarda la semilla para reproducir el escenario que vio el asesor.
model ExcelAttemptResult {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId       String        @unique @map("attempt_id") @db.Uuid
  excelActivityId String        @map("excel_activity_id") @db.Uuid
  excelVersion    Int           @map("excel_version")
  seed            Int
  configSnapshot  Json          @map("config_snapshot")
  score           Decimal?      @db.Decimal(5, 2)
  passed          Boolean?
  stepResults     Json?         @map("step_results")
  startedAt       DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime?     @map("completed_at") @db.Timestamptz(6)
  attempt         Attempt       @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  excelActivity   ExcelActivity @relation(fields: [excelActivityId], references: [id], onDelete: Restrict)

  @@index([excelActivityId])
  @@map("resultados_excel")
  @@schema("induccion")
}

// Ejercicio de dictado. No se activa sin audio autorizado (salvo DICTATION_DEV_TTS en desarrollo).
model DictationExercise {
  id                   String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                  String                   @db.VarChar(60)
  version              Int                      @default(1)
  title                String                   @db.VarChar(150)
  audioKey             String?                  @map("audio_key") @db.VarChar(120)
  audioDurationSeconds Int?                     @map("audio_duration_seconds")
  expectedText         String                   @map("expected_text")
  locale               String                   @default("es-CO") @db.VarChar(10)
  difficulty           Int                      @default(1)
  criticalRuleKeys     String[]                 @map("critical_rule_keys")
  status               CatalogStatus            @default(DRAFT)
  createdById          String?                  @map("created_by_id") @db.Uuid
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy            Usuario?                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  results              DictationAttemptResult[]

  @@unique([key, version])
  @@index([status])
  @@map("ejercicios_dictado")
  @@schema("induccion")
}

// Catálogo del sistema experto. pairs: [["a ver","haber"], ...] (esperado, confusión frecuente).
model SpellingRule {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String           @db.VarChar(60)
  version     Int              @default(1)
  category    SpellingCategory
  severity    SpellingSeverity
  weight      Decimal          @db.Decimal(5, 2)
  pairs       Json
  explanation String
  examples    Json
  status      CatalogStatus    @default(DRAFT)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([key, version])
  @@index([status])
  @@map("reglas_ortografia")
  @@schema("induccion")
}

// Intento de dictado: se crea al abrirlo (cuenta reproducciones) y se completa al enviarlo.
model DictationAttemptResult {
  id                          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attemptId                   String                @unique @map("attempt_id") @db.Uuid
  exerciseId                  String                @map("exercise_id") @db.Uuid
  exerciseVersion             Int                   @map("exercise_version")
  expectedText                String                @map("expected_text")
  playsUsed                   Int                   @default(0) @map("plays_used")
  typedText                   String?               @map("typed_text")
  typedNormalized             String?               @map("typed_normalized")
  score                       Decimal?              @db.Decimal(5, 2)
  wordMatchPercent            Decimal?              @map("word_match_percent") @db.Decimal(5, 2)
  detectedErrors              Json?                 @map("detected_errors")
  criticalCount               Int?                  @map("critical_count")
  passed                      Boolean?
  rulesVersion                Int?                  @map("rules_version")
  configSnapshot              Json                  @map("config_snapshot")
  recommendation              Json?
  recommendationSource        RecommendationSource? @map("recommendation_source")
  recommendationPromptVersion String?               @map("recommendation_prompt_version") @db.VarChar(40)
  startedAt                   DateTime              @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt                 DateTime?             @map("completed_at") @db.Timestamptz(6)
  attempt                     Attempt               @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  exercise                    DictationExercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([exerciseId])
  @@index([completedAt])
  @@map("resultados_dictado")
  @@schema("induccion")
}
