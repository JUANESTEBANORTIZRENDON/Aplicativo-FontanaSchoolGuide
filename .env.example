DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER/BASE_DE_DATOS?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST-DIRECTO/BASE_DE_DATOS?sslmode=require"
PORT=3000
NODE_ENV=development
SESSION_SECRET="reemplazar-con-una-clave-aleatoria-de-al-menos-32-caracteres"

# Base de pruebas (rama de Neon de desarrollo o PostgreSQL local). Nunca la de producción.
# `npm test` la usa en lugar de DATABASE_URL y se niega a correr si no está definida.
