DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-POOLER/BASE_DE_DATOS?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST-DIRECTO/BASE_DE_DATOS?sslmode=require"
PORT=3000
NODE_ENV=development
SESSION_SECRET="reemplazar-con-una-clave-aleatoria-de-al-menos-32-caracteres"

# Base de pruebas (rama de Neon de desarrollo o PostgreSQL local). Nunca la de producción.
# `npm test` la usa en lugar de DATABASE_URL y se niega a correr si no está definida.
DATABASE_URL_TEST="postgresql://USUARIO:CONTRASENA@HOST-RAMA-PRUEBAS/BASE_DE_DATOS?sslmode=require"
DIRECT_URL_TEST="postgresql://USUARIO:CONTRASENA@HOST-RAMA-PRUEBAS-DIRECTO/BASE_DE_DATOS?sslmode=require"

# Presentación de fechas y filtros de métricas.
APP_TIMEZONE="America/Bogota"
# Días sin avance para considerar a un asesor "detenido".
STALLED_DAYS=7
# Emisión automática de certificados (pendiente de aprobar diseño y vigencia).
CERTIFICATES_ENABLED=false
# Activa el webhook de mecanografía (borrador). Vacío: la ruta responde 404.
TYPING_WEBHOOK_SECRET=""

# Protección de seeds y pruebas.
SEED_ALLOW=false
# Hosts no locales donde se permite sembrar, separados por comas (rama de pruebas de Neon).
SEED_ALLOWED_HOSTS=""
# Hosts de producción: los seeds y las pruebas se niegan a usarlos.
PRODUCTION_DATABASE_HOSTS=""
